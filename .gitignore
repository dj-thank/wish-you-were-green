# Local Python environments and runtime caches. Curated research data remain visible.
.venv*/
venv/
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.pytest_cache/
.mypy_cache/
.ruff_cache/
mpl-cache/
.matplotlib/
.jupyter/
.coverage
coverage.xml
htmlcov/
*.log
*.tmp
*.part
.DS_Store
Thumbs.db

# Uncompressed regeneration products; the corresponding curated .gz snapshots stay visible.
/results/all_spectra_screen.csv
/results/all_object_candidates.csv
/results/screen_input_mwdd.json
/results/screen_input_sdss.json
/results/mwdd_screen.csv
/results/mwdd_screen_annotated.csv
/results/mwdd_object_candidates.csv
/results/sdss_screen.csv
/results/sdss_screen_annotated.csv
/results/sdss_object_candidates.csv
/results/redownload_verification.json
/mwdd/manifest_enriched.json
/sdss/manifest_with_photometry.json
/mwdd/source_checksums.csv
/mwdd/input_quality.csv

# Optional bulk catalogue and literature caches are not part of the curated checkout.
/mwdd/table.json
/mwdd/table.json.gz
/mwdd/table.json.source.json
/novelty/primary_papers/*_source.tar
/novelty/primary_papers/*.pdf
/novelty/primary_papers/DESI_DR1_*.csv.gz

