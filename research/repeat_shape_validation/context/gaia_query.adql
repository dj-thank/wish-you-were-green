SELECT g.source_id,g.ra,g.dec,g.ref_epoch,g.parallax,g.parallax_error,g.pmra,g.pmdec,g.phot_g_mean_mag,g.bp_rp,g.ruwe,g.phot_variable_flag,g.has_xp_continuous,g.duplicated_source,g.non_single_star,g.ipd_frac_multi_peak,v.classifier_name,v.best_class_name,v.best_class_score FROM gaiadr3.gaia_source AS g LEFT OUTER JOIN gaiadr3.vari_classifier_result AS v ON g.source_id=v.source_id WHERE g.source_id=3646912496889350784 OR 1=CONTAINS(POINT('ICRS',g.ra,g.dec),CIRCLE('ICRS',212.5239,-2.5835637,0.004166666666666667)) ORDER BY g.source_id
