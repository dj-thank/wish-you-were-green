SELECT source_id,ra,dec,ref_epoch,ra_error,dec_error,parallax,parallax_error,pmra,pmdec,pmra_error,pmdec_error,ruwe,phot_g_mean_mag,phot_bp_mean_mag,phot_rp_mean_mag FROM gaiadr3.gaia_source WHERE 1=CONTAINS(POINT('ICRS',ra,dec),CIRCLE('ICRS',34.41364554632023,1.2781502449538593,0.004166666666667)) OR 1=CONTAINS(POINT('ICRS',ra,dec),CIRCLE('ICRS',1.5126954601418308,2.962546104928232,0.004166666666667)) OR 1=CONTAINS(POINT('ICRS',ra,dec),CIRCLE('ICRS',67.43628526183477,-3.9065060610064495,0.004166666666667)) OR 1=CONTAINS(POINT('ICRS',ra,dec),CIRCLE('ICRS',200.80308349613566,-1.490425135401572,0.004166666666667)) OR 1=CONTAINS(POINT('ICRS',ra,dec),CIRCLE('ICRS',194.51120239880106,5.010742767427144,0.004166666666667))
