SELECT source_id,ra,dec,ref_epoch,ra_error,dec_error,parallax,parallax_error,pmra,pmdec,pmra_error,pmdec_error,ruwe,phot_g_mean_mag,phot_bp_mean_mag,phot_rp_mean_mag FROM gaiadr3.gaia_source WHERE 1=CONTAINS(POINT('ICRS',ra,dec),CIRCLE('ICRS',202.4277131219403,0.5596391080486938,0.004166666666667)) OR 1=CONTAINS(POINT('ICRS',ra,dec),CIRCLE('ICRS',205.32796587016185,2.4596911131581094,0.004166666666667)) OR 1=CONTAINS(POINT('ICRS',ra,dec),CIRCLE('ICRS',157.80770360075527,-1.6573008896492452,0.004166666666667)) OR 1=CONTAINS(POINT('ICRS',ra,dec),CIRCLE('ICRS',250.64283127847207,8.07657847545214,0.004166666666667)) OR 1=CONTAINS(POINT('ICRS',ra,dec),CIRCLE('ICRS',256.91219379965986,14.889203633294283,0.004166666666667))
