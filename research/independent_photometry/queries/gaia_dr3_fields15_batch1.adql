SELECT source_id,ra,dec,ref_epoch,ra_error,dec_error,parallax,parallax_error,pmra,pmdec,pmra_error,pmdec_error,ruwe,phot_g_mean_mag,phot_bp_mean_mag,phot_rp_mean_mag FROM gaiadr3.gaia_source WHERE 1=CONTAINS(POINT('ICRS',ra,dec),CIRCLE('ICRS',193.97034380874845,67.21207849835115,0.004166666666667)) OR 1=CONTAINS(POINT('ICRS',ra,dec),CIRCLE('ICRS',193.02978541068498,74.96564916410546,0.004166666666667)) OR 1=CONTAINS(POINT('ICRS',ra,dec),CIRCLE('ICRS',280.26958103994514,48.64693611934186,0.004166666666667)) OR 1=CONTAINS(POINT('ICRS',ra,dec),CIRCLE('ICRS',26.800166436616863,-13.978845446932713,0.004166666666667)) OR 1=CONTAINS(POINT('ICRS',ra,dec),CIRCLE('ICRS',17.853112254737606,-5.55553356557708,0.004166666666667))
