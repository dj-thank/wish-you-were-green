SELECT source_id,ra,dec,ref_epoch,parallax,parallax_error,pmra,pmdec,ruwe,phot_g_mean_mag,bp_rp,phot_variable_flag,duplicated_source,non_single_star,has_xp_continuous,ipd_frac_multi_peak FROM gaiadr3.gaia_source WHERE source_id IN (4518692348609283712,2780975896637670528,3217759570831525120) OR 1=CONTAINS(POINT('ICRS',ra,dec),CIRCLE('ICRS',282.669583333333,20.015583333333,0.0041666666667)) OR 1=CONTAINS(POINT('ICRS',ra,dec),CIRCLE('ICRS',11.365375000000,14.637816666667,0.0041666666667)) OR 1=CONTAINS(POINT('ICRS',ra,dec),CIRCLE('ICRS',83.973208333333,-0.667861111111,0.0041666666667)) ORDER BY source_id
