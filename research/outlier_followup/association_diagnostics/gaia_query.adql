SELECT g.source_id,g.ra,g.dec,g.ref_epoch,g.ra_error,g.dec_error,g.parallax,g.parallax_error,g.pmra,g.pmdec,g.pmra_error,g.pmdec_error,g.phot_g_mean_mag,g.bp_rp,g.ruwe,g.phot_variable_flag,g.phot_bp_rp_excess_factor,v.best_class_name,v.best_class_score FROM gaiadr3.gaia_source AS g LEFT OUTER JOIN gaiadr3.vari_classifier_result AS v ON g.source_id=v.source_id WHERE g.source_id IN (1038076351151065088,1311674353544358912,2586182156053386240,1025033665052512000) ORDER BY g.source_id
