SELECT g.source_id,g.ra,g.dec,g.ref_epoch,g.pmra,g.pmdec,g.phot_g_mean_mag,g.bp_rp,g.ruwe,g.phot_variable_flag,g.has_xp_continuous,v.classifier_name,v.best_class_name,v.best_class_score FROM gaiadr3.gaia_source AS g LEFT OUTER JOIN gaiadr3.vari_classifier_result AS v ON g.source_id=v.source_id WHERE g.source_id IN (1060188315963488640,3688869246424920448,2629980411471669632,2802900781266410112,4573582236809330432,2163612727665972096,2002597083798483200,5078976609103251456,1245262790370992256) ORDER BY g.source_id
