SELECT g.source_id,g.ra,g.dec,g.ref_epoch,g.pmra,g.pmdec,g.phot_g_mean_mag,g.bp_rp,g.ruwe,g.phot_variable_flag,g.has_xp_continuous,v.classifier_name,v.best_class_name,v.best_class_score FROM gaiadr3.gaia_source AS g LEFT OUTER JOIN gaiadr3.vari_classifier_result AS v ON g.source_id=v.source_id WHERE g.source_id IN (1951666884868218112,2096274276193099136,2208124536065383424,4565045873343899136,5589261737965864832) ORDER BY g.source_id
